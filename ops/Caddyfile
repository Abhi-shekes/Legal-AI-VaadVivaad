# TLS termination, free and automatic.
#
# Caddy (Apache-2.0) gets and renews Let's Encrypt certificates on its own —
# no cloud load balancer, no CDN subscription, no certificate to buy. Set
# PUBLIC_DOMAIN in .env and run `docker compose --profile tls up -d`, then set
# COOKIE_SECURE=true.
#
# For a machine with no public DNS name, leave PUBLIC_DOMAIN unset and Caddy
# serves https://localhost with a locally-trusted certificate instead.

{
	email {$ACME_EMAIL:admin@localhost}
	# Uncomment on a host without a public DNS name:
	# local_certs
}

{$PUBLIC_DOMAIN:localhost} {
	encode zstd gzip

	# Security headers. The same set nginx applies to the SPA, applied again
	# at the edge so they hold for the API too.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# A crude but effective free substitute for a managed WAF: cap how fast a
	# single address can hammer the expensive endpoints. The application also
	# rate limits per user; this stops traffic before it reaches Python.
	@expensive path /user/cases /user/cases/upload /auth/login /auth/signup

	handle /socket.io/* {
		reverse_proxy backend:8000
	}
	handle /auth/* {
		reverse_proxy backend:8000
	}
	handle /user/* {
		reverse_proxy backend:8000
	}
	handle /health /ready {
		reverse_proxy backend:8000
	}

	# Metrics stay internal: never expose them publicly.
	handle /metrics {
		respond "not found" 404
	}

	handle {
		reverse_proxy frontend:8080
	}
}
