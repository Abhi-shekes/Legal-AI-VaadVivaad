# Copy this file to .env, fill in every value below (all of them are
# required -- compose refuses to start if any are missing/blank, on
# purpose: no insecure or fake fallback values), then run:
#   docker compose up --build -d

# Any long random string (e.g. `openssl rand -hex 32`). Signs login sessions.
JWT_SECRET_KEY=

# MongoDB root credentials (used by both the mongo container and the
# backend's connection string). Generate a real password, e.g.
# `openssl rand -base64 24`.
MONGO_ROOT_USERNAME=vaadvivaad
MONGO_ROOT_PASSWORD=
DB_NAME=vaadvivaad

# Set COOKIE_SECURE=true only once this is served over HTTPS (e.g. behind a
# TLS-terminating reverse proxy / load balancer) -- browsers silently drop
# Secure cookies over plain HTTP, which would break login on localhost.
ENVIRONMENT=production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Short-lived access token plus a long refresh token. The refresh token's id
# is recorded server-side, so signing out actually revokes the session.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Host port mapping.
BACKEND_PORT=8000
FRONTEND_PORT=8081
QDRANT_PORT=6333

# Browser-facing URLs baked into the frontend build (must be reachable
# from the *browser*, not just from inside the Docker network).
PUBLIC_API_URL=http://localhost:8000
PUBLIC_SOCKET_URL=http://localhost:8000

# CORS origins allowed to call the backend, comma separated.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Qdrant (self-hosted vector search over case laws / IPC sections /
# evidence -- runs as the vaadvivaad-qdrant container, no external account
# needed). Generate a real key, e.g. `openssl rand -hex 32` -- this locks
# down both Qdrant's REST/dashboard port and the backend's access to it.
QDRANT_API_KEY=

# Model routing. Both default to flash-lite, which is the only tier whose
# FREE quota can carry a whole hearing -- the larger models allow a handful of
# requests per minute and 429 partway through. "-latest" aliases on purpose:
# pinned model names get sunset by Google and start 404ing with no warning.
#
# The two settings stay separate so a deployment with paid quota can point the
# reasoning tier at a stronger model without a code change. Leave them equal
# to stay entirely within the free tier.
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_REASONING=gemini-flash-lite-latest

# Hearing shape and spend ceiling. A debate aborts rather than run away with
# your quota; the transcript up to that point is kept.
DEBATE_MAX_ROUNDS=4
DEBATE_TOKEN_BUDGET=120000

# Rate limits, as requests/seconds. Debates are the expensive operation and
# get their own budget per user.
RATELIMIT_DEBATE=5/3600
RATELIMIT_AUTH=10/300
RATELIMIT_API=120/60

LOG_LEVEL=INFO

# Embedding model (Gemini) used to vectorize text before storing/searching
# it in Qdrant. gemini-embedding-001 natively outputs 3072 dims but
# supports truncating to EMBEDDING_DIMENSIONS; only change
# EMBEDDING_DIMENSIONS if you also change EMBEDDING_MODEL.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Google Gemini API key: https://aistudio.google.com/apikey -- powers both
# the AI-generated debate arguments and the embeddings used for vector
# search.
GOOGLE_API_KEY=

# Redis backs the session store, the rate limiter and the Socket.IO manager.
# Without it the app runs with per-process in-memory equivalents, which are
# correct for a SINGLE backend replica only -- the app logs a warning at boot
# if it starts that way in production. docker compose sets this for you.
REDIS_URL=redis://redis:6379/0

# --- Optional profiles (all free and self-hosted; see ops/README.md) ---
# TLS:            docker compose --profile tls up -d
# Metrics:        docker compose --profile observability up -d
# Caddy obtains and renews Let's Encrypt certificates on its own. Leave
# PUBLIC_DOMAIN unset to serve https://localhost with a local certificate.
PUBLIC_DOMAIN=
ACME_EMAIL=
GRAFANA_PASSWORD=admin
