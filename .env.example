# Copy this file to .env, fill in real values, then run:
#   docker compose up --build -d
#
# Everything below has a working default in docker-compose.yml except
# JWT_SECRET_KEY (required -- compose refuses to start without it). With
# just that set, auth/dashboard/case-history work immediately, and Qdrant
# (self-hosted, no account needed) is already wired up. The vector-search
# and debate-argument features only produce real results once you set a
# real GOOGLE_API_KEY -- Gemini both generates the arguments and computes
# the embeddings used for Qdrant search.

# --- Required ---
# Any long random string (e.g. `openssl rand -hex 32`). Signs login sessions.
JWT_SECRET_KEY=

# --- MongoDB root credentials (used by both the mongo container and the
#     backend's connection string) ---
MONGO_ROOT_USERNAME=vaadvivaad
MONGO_ROOT_PASSWORD=changeme_dev_password
DB_NAME=vaadvivaad

# --- Runtime / cookie security ---
# Set COOKIE_SECURE=true only once this is served over HTTPS (e.g. behind a
# TLS-terminating reverse proxy / load balancer) -- browsers silently drop
# Secure cookies over plain HTTP, which would break login on localhost.
ENVIRONMENT=production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Host port mapping ---
BACKEND_PORT=8000
FRONTEND_PORT=8081
QDRANT_PORT=6333

# --- Browser-facing URLs baked into the frontend build (must be reachable
#     from the *browser*, not just from inside the Docker network) ---
PUBLIC_API_URL=http://localhost:8000
PUBLIC_SOCKET_URL=http://localhost:8000

# --- CORS origins allowed to call the backend, comma separated ---
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# --- Qdrant (self-hosted vector search over case laws / IPC sections /
#     evidence -- runs as the vaadvivaad-qdrant container, no external
#     account needed). Leave QDRANT_API_KEY blank for local use; set it to
#     require auth on Qdrant's REST/dashboard port. ---
QDRANT_API_KEY=

# --- Embedding model (Gemini) used to vectorize text before storing/
#     searching it in Qdrant. Only change EMBEDDING_DIMENSIONS if you also
#     change EMBEDDING_MODEL to one with a different output size. ---
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# --- Google Gemini API key. Required for real results from both the
#     AI-generated debate arguments AND vector search (Gemini computes the
#     embeddings) -- without it, those features degrade to empty results /
#     a clean "server busy" error instead of crashing. ---
GOOGLE_API_KEY=
