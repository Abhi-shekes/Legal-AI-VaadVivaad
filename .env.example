# Copy this file to .env, fill in every value below (all of them are
# required -- compose refuses to start if any are missing/blank, on
# purpose: no insecure or fake fallback values), then run:
#   docker compose up --build -d

# Any long random string (e.g. `openssl rand -hex 32`). Signs login sessions.
JWT_SECRET_KEY=

# MongoDB root credentials (used by both the mongo container and the
# backend's connection string). Generate a real password, e.g.
# `openssl rand -base64 24`.
MONGO_ROOT_USERNAME=vaadvivaad
MONGO_ROOT_PASSWORD=
DB_NAME=vaadvivaad

# Set COOKIE_SECURE=true only once this is served over HTTPS (e.g. behind a
# TLS-terminating reverse proxy / load balancer) -- browsers silently drop
# Secure cookies over plain HTTP, which would break login on localhost.
ENVIRONMENT=production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Short-lived access token plus a long refresh token. The refresh token's id
# is recorded server-side, so signing out actually revokes the session.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Host port mapping.
BACKEND_PORT=8000
FRONTEND_PORT=8081
QDRANT_PORT=6333

# Browser-facing URLs baked into the frontend build (must be reachable
# from the *browser*, not just from inside the Docker network).
PUBLIC_API_URL=http://localhost:8000
PUBLIC_SOCKET_URL=http://localhost:8000

# CORS origins allowed to call the backend, comma separated.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Qdrant (self-hosted vector search over case laws / IPC sections /
# evidence -- runs as the vaadvivaad-qdrant container, no external account
# needed). Generate a real key, e.g. `openssl rand -hex 32` -- this locks
# down both Qdrant's REST/dashboard port and the backend's access to it.
QDRANT_API_KEY=

# Model routing. The fast tier carries the bulk of a hearing and must be a
# lite model: the larger tiers allow only a handful of FREE requests per
# minute and 429 partway through.
#
# These are pinned, not "-latest" aliases. Both directions carry a risk --
# a pinned name can be sunset and start 404ing, and an alias can silently
# re-point onto a model that is failing. The second is what actually
# happened: gemini-flash-lite-latest moved to gemini-3.5-flash-lite, which
# returned a sustained 503 UNAVAILABLE, and because BOTH tiers resolved to
# that one alias the entire hearing pipeline went down with nowhere to fall
# back to. A pinned name at least fails loudly and identically every time.
#
# GEMINI_MODEL_FALLBACK is the answer to both risks: when a tier's circuit
# breaker opens -- on quota refusal (429) or sustained unavailability (5xx)
# -- the client routes here instead of failing the hearing. Keep it on the
# cheapest, most consistently available model, and do not set it equal to
# either tier or the fallback has nowhere to go.
#
# Verify a model before pinning it:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models/\
#   MODEL:generateContent?key=$GOOGLE_API_KEY" -H 'Content-Type: application/json' \
#   -d '{"contents":[{"parts":[{"text":"say ok"}]}]}'
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_REASONING=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3-flash-preview

# Hearing shape and spend ceiling. A debate aborts rather than run away with
# your quota; the transcript up to that point is kept.
DEBATE_MAX_ROUNDS=4
DEBATE_TOKEN_BUDGET=120000

# Rate limits, as requests/seconds. Debates are the expensive operation and
# get their own budget per user.
RATELIMIT_DEBATE=5/3600
RATELIMIT_AUTH=10/300
RATELIMIT_API=120/60

LOG_LEVEL=INFO

# Embedding model (Gemini) used to vectorize text before storing/searching
# it in Qdrant. gemini-embedding-001 natively outputs 3072 dims but
# supports truncating to EMBEDDING_DIMENSIONS; only change
# EMBEDDING_DIMENSIONS if you also change EMBEDDING_MODEL.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ── Retrieval: hybrid search and local models ────────────────────────────
#
# HYBRID_SEARCH runs a BM25 sparse vector alongside the dense one and fuses
# the two result lists by reciprocal rank. It costs nothing extra -- the
# sparse side is computed in-process by `fastembed`, which carries no neural
# weights -- and it is what lets a query actually match on `302`, `BNS 103`
# or a party's name rather than only on the shape of the facts.
#
# Leave it on. It quietly disables itself if `fastembed` is not importable.
# A collection built before hybrid retrieval has no sparse vector; the backend
# says so at boot and the fix is a one-off:
#
#     docker compose exec backend python -m app.services.ingest.pipeline \
#         --recreate --yes --source fixtures/seed_corpus.jsonl
HYBRID_SEARCH=true

# Where dense embeddings come from.
#   gemini  (default) -- one external service, no extra containers
#   local             -- a Text Embeddings Inference container, no API quota
#
# `local` is what makes a large ingest practical: a 10,000-judgment corpus is
# 10,000 quota'd requests through Gemini. Start the containers with
# `docker compose --profile retrieval up -d`, then set:
#
#     EMBEDDING_PROVIDER=local
#     EMBEDDING_DIMENSIONS=1024      # bge-m3, not 768
#     TEI_EMBED_URL=http://tei-embed:80
#
# Changing provider changes the vector width, so the collection must be
# rebuilt with --recreate as above. Doing it against the old width does not
# error -- it just returns nothing, which is worse.
EMBEDDING_PROVIDER=gemini
TEI_EMBED_URL=

# Cross-encoder reranking. Empty disables it and retrieval falls back to the
# deterministic feature ranking (section overlap, court seniority, recency).
# Set it to http://tei-rerank:80 with the `retrieval` profile running.
#
# The cross-encoder does not replace those features, it is blended with them
# at RERANK_WEIGHT: a reranker has no idea that apex authority on the same
# provision binds harder than a magistrate's view of different facts.
TEI_RERANK_URL=

# ── Search over your own hearings (F-08) ─────────────────────────────────
#
# Empty falls back to a MongoDB text index, which finds a case by its
# description and offence type but cannot reach the transcript -- the index
# only covers the fields it was built on. Good enough to ship with; not good
# enough to find "the matter where counsel argued about the dying
# declaration".
#
# Meilisearch searches the whole record -- every turn, the order, and the
# questions put to the bench afterwards -- with typo tolerance, in ~150 MB:
#
#     docker compose --profile search up -d
#     MEILI_URL=http://meilisearch:7700
#
# Then backfill once (new hearings index themselves as they finish):
#
#     docker compose exec backend python -c \
#       "import asyncio; from app.services import search; \
#        print(asyncio.run(search.reindex_all()))"
#
# MEILI_MASTER_KEY follows QDRANT_API_KEY's posture: blank means no auth,
# which is fine on the private Docker network and not fine if you publish
# the port. Nothing maps a host port for it by default.
MEILI_URL=
MEILI_MASTER_KEY=

# ── Live grounding: outside the record (F-09) ────────────────────────────
#
# The corpus is a snapshot. A judgment from last month or an amendment
# notified this year does not exist for precedent retrieval, which correctly
# returns nothing and lets the hearing argue from statute alone.
#
# SearXNG is a metasearch front end -- no API key, no index, no account -- and
# it is the only container in this stack that talks to the open internet:
#
#     SEARXNG_SECRET=$(openssl rand -hex 32)     # required; it refuses to
#                                                # start without one
#     docker compose --profile websearch up -d
#     SEARXNG_URL=http://searxng:8080
#
# What comes back is NEVER citable and never reaches counsel. It is filtered
# to an allowlist of official publishers and shown to the person in a panel
# marked as outside the record. `citations.verify_turn()` would strip any
# authority a model tried to cite from it, which is what stops this quietly
# becoming a grounding source.
#
# WEBSEARCH_ALLOWLIST is comma-separated and overrides the default list
# (sci.gov.in, indiacode.gov.in, judgments.ecourts.gov.in, egazette.gov.in,
# prsindia.org, indiankanoon.org). Matching is on the parsed host, so a
# subdomain is fine and a lookalike parent domain is not.
SEARXNG_SECRET=
SEARXNG_URL=
WEBSEARCH_ALLOWLIST=

# ── Voice: dictation in, the hearing read out (F-10) ─────────────────────
#
# translation.py already reasons in English, Hindi, Marathi, Bengali, Tamil,
# Telugu and Gujarati -- and the only way into the product is a textarea.
# Someone who has just been to a police station is not going to compose a
# paragraph of legal English. These close that gap:
#
#     docker compose --profile voice up -d
#     WHISPER_URL=http://whisper:8000
#     PIPER_URL=http://piper:5000
#
# Both are optional, independent and small. faster-whisper `small` at int8 is
# ~500 MB resident and handles the Indic languages well; Piper is ~50 MB and
# faster than realtime on a CPU. Neither needs a GPU. GET /user/voice reports
# each separately, and the UI hides whichever is missing rather than offering
# a button that fails.
#
# The transcript joins the existing path -- to_english() then intake.prepare()
# -- so a case dictated in Marathi becomes the same CaseStructure a typed one
# does. Whisper's own language detection is used rather than the script-range
# check in translation.py, because Hindi and Marathi share Devanagari and
# cannot be told apart by codepoint.
#
# WHISPER_MODEL trades accuracy for memory: `tiny` / `base` / `small` /
# `medium` / `large-v3`. Anything above `small` wants a GPU to stay usable.
WHISPER_URL=http://whisper:8000
WHISPER_MODEL=Systran/faster-whisper-small
PIPER_URL=tcp://piper:10200

# Google Gemini API key: https://aistudio.google.com/apikey -- powers both
# the AI-generated debate arguments and the embeddings used for vector
# search.
GOOGLE_API_KEY=

# Redis backs the session store, the rate limiter and the Socket.IO manager.
# Without it the app runs with per-process in-memory equivalents, which are
# correct for a SINGLE backend replica only -- the app logs a warning at boot
# if it starts that way in production. docker compose sets this for you.
REDIS_URL=redis://redis:6379/0

# --- Optional profiles (all free and self-hosted; see ops/README.md) ---
# TLS:            docker compose --profile tls up -d
# Metrics:        docker compose --profile observability up -d
# Caddy obtains and renews Let's Encrypt certificates on its own. Leave
# PUBLIC_DOMAIN unset to serve https://localhost with a local certificate.
PUBLIC_DOMAIN=
ACME_EMAIL=
GRAFANA_PASSWORD=admin
